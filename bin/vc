#!/usr/bin/env python3
import argparse
import json
import re
import shutil
import subprocess
import time
import urllib.request
from pathlib import Path

API = "https://kenkoooo.com/atcoder"


def fetch(url: str):
    req = urllib.request.Request(url, headers={"User-Agent": "atcoder-docker/vc"})
    with urllib.request.urlopen(req) as r:
        return json.load(r)


def acc(*args: str) -> str:
    return subprocess.run(["acc", *args], capture_output=True, text=True, check=True).stdout.strip()


def labels(n: int) -> list[str]:
    # AtCoder Problems の表示に合わせ A, B, ... と振る。26 問を超えたら番号にする
    if n <= 26:
        return [chr(ord("a") + i) for i in range(n)]
    return [f"{i + 1:02}" for i in range(n)]


def main() -> None:
    p = argparse.ArgumentParser(prog="vc")
    p.add_argument("contest", help="https://kenkoooo.com/atcoder/#/contest/show/<ID> または ID")
    p.add_argument("-t", "--template", help="acc のテンプレート名 (既定: acc config default-template)")
    a = p.parse_args()

    m = re.search(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", a.contest)
    if not m:
        p.error("コンテスト ID (UUID) が見つからない")
    name = a.template or acc("config", "default-template")
    if not name:
        p.error("-t でテンプレートを指定する (acc config default-template が未設定)")
    tmpl = Path(acc("config-dir")) / name
    if not (tmpl / "template.json").is_file():
        p.error(f"acc のテンプレート '{name}' がない")
    spec = json.loads((tmpl / "template.json").read_text())["task"]

    cid = m.group()
    contest = fetch(f"{API}/internal-api/contest/get/{cid}")
    # 問題 ID から所属コンテストを引く (共有問題は ID の接頭辞とコンテストが一致しない)
    problem = {q["id"]: q for q in fetch(f"{API}/resources/problems.json")}

    root = Path("vc") / cid[:8]
    problems = sorted(contest["problems"], key=lambda q: q["order"])
    rows = []
    for label, q in zip(labels(len(problems)), problems):
        info = problem.get(q["id"])
        if info is None:
            print(f"skip {q['id']}: AtCoder Problems の問題一覧にない")
            continue
        url = f"https://atcoder.jp/contests/{info['contest_id']}/tasks/{q['id']}"
        rows.append(f"| {label.upper()} | [{info['title']}]({url}) |")
        d = root / label
        if d.exists():
            print(f"skip {d}: 既にある")
            continue
        d.mkdir(parents=True)
        for f in spec["program"]:
            shutil.copy(tmpl / f, d / f)
        if "cmd" in spec:
            subprocess.run(["bash", "-c", spec["cmd"]], cwd=d, check=True)
        # インタラクティブ問題などサンプルの無い問題は、acc new と同じく警告して続ける
        if subprocess.run(["oj", "d", url], cwd=d).returncode != 0:
            print(f"warning {d}: サンプルを取得できなかった ({url})")
        time.sleep(1)  # AtCoder への連続アクセスを避ける

    info = contest["info"]
    root.mkdir(parents=True, exist_ok=True)
    (root / "README.md").write_text(
        f"# {info['title']}\n\n{API}/#/contest/show/{cid}\n\n| | 問題 |\n|---|---|\n" + "\n".join(rows) + "\n"
    )
    print(root)


if __name__ == "__main__":
    main()
